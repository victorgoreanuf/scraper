            "domSelectorCodeUnits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "domMatchesPerSelector": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "javascriptPaths": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "javascriptPathCodeUnits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "returnedValueBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "returnedValuesBytesPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            }
          }
        },
        "detector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workers",
            "catalogFiles",
            "catalogFileBytes",
            "catalogBytes",
            "catalogJsonDepth",
            "technologiesPerCatalog",
            "technologyNameCodePoints",
            "categoryNameCodePoints",
            "categoriesPerTechnology",
            "categoriesPerCatalog",
            "relationshipEdgesPerCatalog",
            "patternsPerCatalog",
            "patternSourceCodeUnits",
            "totalPatternSourceCodeUnits",
            "compileWatchdogMs",
            "workerOldHeapBytes",
            "workerYoungHeapBytes",
            "workerStackBytes",
            "ruleWatchdogMs",
            "watchdogPollMs",
            "activeMsPerDomain",
            "timeoutsPerDomain",
            "checkpointRules",
            "executionsPerDomain"
          ],
          "properties": {
            "workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "catalogFiles": {
              "type": "integer",
              "minimum": 29,
              "maximum": 64
            },
            "catalogFileBytes": {
              "type": "integer",
              "minimum": 524288,
              "maximum": 1048576
            },
            "catalogBytes": {
              "type": "integer",
              "minimum": 4194304,
              "maximum": 16777216
            },
            "catalogJsonDepth": {
              "type": "integer",
              "minimum": 8,
              "maximum": 64
            },
            "technologiesPerCatalog": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "technologyNameCodePoints": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "categoryNameCodePoints": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "categoriesPerTechnology": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "categoriesPerCatalog": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "relationshipEdgesPerCatalog": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "patternsPerCatalog": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "patternSourceCodeUnits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "totalPatternSourceCodeUnits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "compileWatchdogMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            },
            "workerOldHeapBytes": {
              "type": "integer",
              "minimum": 16777216,
              "multipleOf": 1048576,
              "maximum": 134217728
            },
            "workerYoungHeapBytes": {
              "type": "integer",
              "minimum": 4194304,
              "multipleOf": 1048576,
              "maximum": 33554432
            },
            "workerStackBytes": {
              "type": "integer",
              "minimum": 1048576,
              "multipleOf": 1048576,
              "maximum": 4194304
            },
            "ruleWatchdogMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "watchdogPollMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "activeMsPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "timeoutsPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "checkpointRules": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "executionsPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500000
            }
