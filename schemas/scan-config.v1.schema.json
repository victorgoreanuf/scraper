{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:website-technologies-scraper:scan-config:v1",
  "title": "Website Technologies Scraper scan configuration v1",
  "description": "Immutable behavior-affecting scan configuration. Operational CLI paths and presentation options are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scanMode",
    "userAgent",
    "inputPolicy",
    "policyVersions",
    "registryPins",
    "targetPolicy",
    "limits",
    "security"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "scanMode": {
      "type": "string",
      "const": "full"
    },
    "userAgent": {
      "type": "string",
      "minLength": 32,
      "maxLength": 512,
      "pattern": "^WebsiteTechScraper/[A-Za-z0-9][A-Za-z0-9._+~-]{0,63} \\((?:https://[\\x21-\\x27\\x2A-\\x7E]+|mailto:[\\x21-\\x27\\x2A-\\x7E]+@[\\x21-\\x27\\x2A-\\x7E]+)\\)$"
    },
    "inputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "selectedColumn", "allowedCodecs"],
      "properties": {
        "format": {
          "type": "string",
          "const": "parquet"
        },
        "selectedColumn": {
          "type": "string",
          "const": "root_domain"
        },
        "allowedCodecs": {
          "type": "array",
          "const": ["UNCOMPRESSED", "SNAPPY"]
        }
      }
    },
    "policyVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parquet",
        "hostname",
        "address",
        "target",
        "robots",
        "pageSelection",
        "sanitizer",
        "evidence",
        "relationships",
        "detector",
        "browserEgress",
        "infrastructure",
        "output"
      ],
      "properties": {
        "parquet": {
          "type": "integer",
          "const": 1
        },
        "hostname": {
          "type": "integer",
          "const": 1
        },
        "address": {
          "type": "integer",
          "const": 1
        },
        "target": {
          "type": "integer",
          "const": 1
        },
        "robots": {
          "type": "integer",
          "const": 1
        },
        "pageSelection": {
          "type": "integer",
          "const": 1
        },
        "sanitizer": {
          "type": "integer",
          "const": 1
        },
        "evidence": {
          "type": "integer",
          "const": 1
        },
        "relationships": {
          "type": "integer",
          "const": 1
        },
        "detector": {
          "type": "integer",
          "const": 1
        },
        "browserEgress": {
          "type": "integer",
          "const": 1
        },
        "infrastructure": {
          "type": "integer",
          "const": 1
        },
        "output": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "registryPins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specialUseDomainsReviewedOn",
        "ianaIpv4UpdatedOn",
        "ianaIpv6UpdatedOn",
        "addressOverlayVersion"
      ],
      "properties": {
        "specialUseDomainsReviewedOn": {
          "type": "string",
          "const": "2026-08-17"
        },
        "ianaIpv4UpdatedOn": {
          "type": "string",
          "const": "2025-10-09"
        },
        "ianaIpv6UpdatedOn": {
          "type": "string",
          "const": "2025-10-09"
        },
        "addressOverlayVersion": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "targetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateOrder", "portsByScheme", "topLevelMethod"],
      "properties": {
        "candidateOrder": {
          "type": "array",
          "const": [
            "https://{domain}/",
            "https://www.{domain}/",
            "http://{domain}/",
            "http://www.{domain}/"
          ]
        },
        "portsByScheme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http", "https"],
          "properties": {
            "http": {
              "type": "integer",
              "const": 80
            },
            "https": {
              "type": "integer",
              "const": 443
            }
          }
        },
        "topLevelMethod": {
          "type": "string",
          "const": "GET"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "timeMs",
        "parquet",
        "target",
        "hostname",
        "url",
        "http",
        "pages",
        "scripts",
        "browser",
        "cookies",
        "dns",
        "tls",
        "robots",
        "inspection",
        "detector",
        "evidence",
        "output"
      ],
      "properties": {
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["globalHttp", "perOriginHttp", "fullScans"],
          "properties": {
            "globalHttp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "perOriginHttp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "fullScans": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        "timeMs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activeDomain",
            "httpRequest",
            "browserPage",
            "browserSettle",
            "retryAfterCap",
            "robotsCache",
            "dnsLookup"
          ],
          "properties": {
            "activeDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "httpRequest": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "browserPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15000
            },
            "browserSettle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "retryAfterCap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "robotsCache": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "dnsLookup": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "parquet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "rowsPerRowGroup",
            "metadataBytes",
            "selectedChunkCompressedBytes",
            "selectedChunkUncompressedBytes"
          ],
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "rowsPerRowGroup": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "metadataBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "selectedChunkCompressedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            },
            "selectedChunkUncompressedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates", "redirectsPerChain"],
          "properties": {
            "candidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "redirectsPerChain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "hostname": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputCodeUnits"],
          "properties": {
            "inputCodeUnits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            }
          }
        },
        "url": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codeUnits"],
          "properties": {
            "codeUnits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transactionsPerDomain",
            "transientRetriesPerRequest",
            "headerFields",
            "headerBytes",
            "htmlCompressedBytesPerPage",
            "htmlDecompressedBytesPerPage",
            "staticDecompressedBytesPerDomain",
            "probeCompressedBytes",
            "probeDecompressedBytes"
          ],
          "properties": {
            "transactionsPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "transientRetriesPerRequest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "headerFields": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "headerBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "htmlCompressedBytesPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            },
            "htmlDecompressedBytesPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "staticDecompressedBytesPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            },
            "probeCompressedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "probeDecompressedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 524288
            }
          }
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topLevelPerDomain",
            "catalogProbesPerDomain",
            "extractedUrlsPerPage",
            "metadataPerPage",
            "visibleTextBytesPerPage"
          ],
          "properties": {
            "topLevelPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "catalogProbesPerDomain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "extractedUrlsPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            },
            "metadataPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            },
            "visibleTextBytesPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 524288
            }
          }
        },
        "scripts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "urlCandidatesPerDomain",
            "bodiesPerDomain",
            "bodyBytes",
            "totalBodyBytesPerDomain"
          ],
          "properties": {
            "urlCandidatesPerDomain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "bodiesPerDomain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "bodyBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            },
            "totalBodyBytesPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contextsPerDomain",
            "activePagesPerContext",
            "networkHostnamesPerDomain",
            "requestsPerPage",
            "requestsPerDomain",
            "transferBytesPerPage",
            "transferBytesPerDomain"
          ],
          "properties": {
            "contextsPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "activePagesPerContext": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "networkHostnamesPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "requestsPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 150
            },
            "requestsPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "transferBytesPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15728640
            },
            "transferBytesPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31457280
            }
          }
        },
        "cookies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perDomain", "nameCodeUnits", "valueBytes", "totalBytesPerDomain"],
          "properties": {
            "perDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "nameCodeUnits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "valueBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "totalBytesPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recordsPerType", "recordsPerDomain", "txtItemBytes", "textBytesPerDomain"],
          "properties": {
            "recordsPerType": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "recordsPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "txtItemBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "textBytesPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuerBytes"],
          "properties": {
            "issuerBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "robots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bodyBytes",
            "redirects",
            "lines",
            "rules",
            "ruleCodeUnits",
            "matchingStatesPerUrl"
          ],
          "properties": {
            "bodyBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 524288
            },
            "redirects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "lines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            },
            "rules": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "ruleCodeUnits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "matchingStatesPerUrl": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domSelectors",
            "domSelectorCodeUnits",
            "domMatchesPerSelector",
            "javascriptPaths",
            "javascriptPathCodeUnits",
            "returnedValueBytes",
            "returnedValuesBytesPerPage"
          ],
          "properties": {
            "domSelectors": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
