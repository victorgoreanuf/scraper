          "properties": {
            "jsonlRecordBytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 16777216
            },
            "technologiesPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "errorsPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "evidencePerTechnology": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "evidencePerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "inferencesPerTechnology": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "inferencesPerDomain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "robots", "browser", "evidence"],
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowUrlCredentials",
            "allowIpInput",
            "requirePublicAddresses",
            "rejectMixedAddressAnswers",
            "validateConnectedAddress",
            "revalidateRedirects",
            "connectOnlySelectedAddress",
            "verifyTls"
          ],
          "properties": {
            "allowUrlCredentials": {
              "type": "boolean",
              "const": false
            },
            "allowIpInput": {
              "type": "boolean",
              "const": false
            },
            "requirePublicAddresses": {
              "type": "boolean",
              "const": true
            },
            "rejectMixedAddressAnswers": {
              "type": "boolean",
              "const": true
            },
            "validateConnectedAddress": {
              "type": "boolean",
              "const": true
            },
            "revalidateRedirects": {
              "type": "boolean",
              "const": true
            },
            "connectOnlySelectedAddress": {
              "type": "boolean",
              "const": true
            },
            "verifyTls": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "robots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["productToken", "failurePolicy", "protectedTransportRequired"],
          "properties": {
            "productToken": {
              "type": "string",
              "const": "WebsiteTechScraper"
            },
            "failurePolicy": {
              "type": "string",
              "const": "fail-closed"
            },
            "protectedTransportRequired": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedMethods",
            "persistentContexts",
            "sandbox",
            "bypassCsp",
            "serviceWorkers",
            "downloads",
            "permissions",
            "proxyRequired",
            "proxyBypass",
            "startupCanaryRequired",
            "quic",
            "nonProxiedWebRtc",
            "webSockets",
