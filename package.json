{
  "name": "website-technologies-scraper",
  "version": "0.1.5",
  "description": "Batch CLI that detects website technologies with verifiable evidence.",
  "private": true,
  "type": "module",
  "bin": {
    "website-technologies-scraper": "dist/cli.js"
  },
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "postbuild": "node --input-type=module --eval \"import { chmodSync } from 'node:fs'; chmodSync('dist/cli.js', 0o755);\"",
    "start": "node dist/cli.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "hyparquet": "1.28.2",
    "playwright": "1.62.1",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
